# Copiá este archivo como .env.local y completalo con la configuración de tu app web de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps). .env.local nunca se sube al repo.
# Sin este archivo, `npm run dev:emu` corre la app contra los emuladores locales.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
