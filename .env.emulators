# Modo emulador (`npm run dev:emu` y los tests E2E): la app usa los emuladores locales de
# Auth y Firestore en vez del proyecto real. No tiene secretos, por eso sí se sube al repo.
VITE_USE_EMULATORS=true
# Client ID falso: muestra el botón de Sheets. En los E2E, Google se reemplaza por uno falso;
# en `npm run dev:emu`, exportar a Sheets da error (no hay un Google real detrás).
VITE_GOOGLE_CLIENT_ID=demo-client-id.apps.googleusercontent.com
