# Dependencias (se reinstalan con `npm ci`)
node_modules/

# Salidas de build y de tests (se regeneran)
dist/
dist-e2e/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Variables de entorno: nunca se suben. Solo .env.example (sin valores).
.env
.env.*
!.env.example
# Solo activa los emuladores locales, no tiene secretos
!.env.emulators

# Código de la app vieja: contiene una API key. Ahora vive fuera del repo, en
# ../finanzas-personales-referencia/; esto queda por si alguien la vuelve a copiar adentro.
referencia/

# APK: la clave de firma nunca se sube (SRS 9.3, ADR 0028). twa-manifest.json sí: solo tiene
# la ruta y el alias de la clave, no las contraseñas.
*.keystore
*.jks
# APK: salidas del build de Android (se regeneran con `bubblewrap build`)
*.apk
*.aab
*.idsig
android/.gradle/
android/**/build/
android/local.properties

# Firebase: caché local y logs de los emuladores
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
database-debug.log*
pubsub-debug.log*

# Logs y archivos del sistema o del editor
npm-debug.log*
*.log
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Cloudflare Worker (ADR 0031): caché de wrangler y secretos locales
.wrangler/
.dev.vars
